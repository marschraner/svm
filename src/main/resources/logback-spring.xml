<configuration>

  <!-- Spring Boot Default-Konfiguration laden -->
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <!-- Console Appender wie im Default -->
  <!--include resource="org/springframework/boot/logging/logback/console-appender.xml"/-->

  <!-- Optional: File Appender -->
  <!-- <include resource="org/springframework/boot/logging/logback/file-appender.xml"/> -->

  <!-- Console Appender -->
  <appender name="ConsoleAppender" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d [%-6level] %logger{1}:%line - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- File Appender -->
  <appender name="FileAppender" class="ch.qos.logback.core.FileAppender">
    <file>${user.home}/log/Svm.log</file>
    <append>true</append>
    <immediateFlush>true</immediateFlush>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%-6level] %logger{1}:%line - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Hibernate -->
  <!-- Change the level to INFO or DEBUG for troubleshooting -->
  <logger name="org.hibernate" level="WARN"/>
  <!-- Change the level to DEBUG to see the SQL statements generated by Hibernate -->
  <logger name="org.hibernate.SQL" level="ERROR"/>
  <!-- Ignore warning HHH000457: Joined inheritance hierarchy [] defined explicit @DiscriminatorColumn. -->
  <!-- See https://gitlab.ewi.tudelft.nl/eip/labrador/queue/-/issues/398 -->
  <logger name="org.hibernate.boot.model.internal.EntityBinder" level="ERROR"/>
  <!-- Ignore warning HHH10001002: Using built-in connection pool (not intended for production use) -->
  <logger name="org.hibernate.orm.connections.pooling" level="ERROR"/>

  <!-- Docx4j -->
  <!-- Verhindern von Info-Messages und Warnungen von Docx4j im Log -->
  <logger name="org.docx4j" level="WARN"/>
  <logger name="org.docx4j.XmlUtils" level="ERROR"/>

  <!-- SVM -->
  <Logger name="ch.metzenthin.svm.service.impl" level="DEBUG"/>

  <!-- Root Logger -->
  <root level="INFO">
    <appender-ref ref="ConsoleAppender"/>
    <appender-ref ref="FileAppender"/>
  </root>

</configuration>
